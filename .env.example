# LLM — both required, no defaults. The app will fail to start without them.
GROQ_API_KEY=
GROQ_MODEL=

# Embeddings
# Embeddings — Google Gemini API (free tier), no self-hosted model needed
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Vector store: "faiss" or "chroma"
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_DIR=./data/vectorstore

# Supabase auth verification — Railway is stateless and holds no DB/service
# credentials. It only verifies bearer tokens via Supabase's public JWKS.
# Find your project ref in the Supabase dashboard URL.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# MCP servers (stdio commands or SSE URLs — see app/tools/mcp_client.py)
# Search / scraping — direct REST APIs, no MCP servers needed
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Video generation (on-demand only)
VIDEO_API_BASE_URL=https://api.example-video-gen.com
VIDEO_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
FLASHCARD_EXPORT_DIR=./data/flashcards
