# Example environment variables for search providers

# Which provider to use: tavily | firecrawl | mcp
SEARCH_PROVIDER=tavily

# Tavily
TAVILY_ENDPOINT=https://api.tavily.example
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl
FIRECRAWL_ENDPOINT=https://api.firecrawl.example
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# (Optional) MCP for fallback
MCP_ENDPOINT=https://mcp.example
MCP_API_KEY=your_mcp_api_key_here
