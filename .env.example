# Example environment variables for search providers

# Which provider to use: tavily | firecrawl | mcp
SEARCH_PROVIDER=tavily

# Tavily
TAVILY_ENDPOINT=https://api.tavily.example
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl
FIRECRAWL_ENDPOINT=https://api.firecrawl.example
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Search / scraping — direct REST APIs, no MCP servers needed
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Video generation (on-demand only)
VIDEO_API_BASE_URL=https://api.example-video-gen.com
VIDEO_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
FLASHCARD_EXPORT_DIR=./data/flashcards
